{
  "comments": {
    "lineComment": "--",
    "blockComment": ["--[[", "]]"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*--\\[\\[",
      "end": "^\\s*\\]\\]"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:fn|if|while|for|match|struct|enum|interface|impl|repeat)\\b.*$",
    "decreaseIndentPattern": "^\\s*(?:end|else|elseif|until|case)\\b.*$"
  }
}
