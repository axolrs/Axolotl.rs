-- Owner: PascalElixir / axolrs (GitHub org)
-- File: benchmarks/bittorrent/axol/src/main.axol - piece-hashing swarm tracker with precomputed bitmask lookup
--
-- Mirrors ../rust/src/main.rs exactly. Optimized for axolc codegen.

const DEFAULT_WORKLOAD: Int = 500000
const N_PIECES: Int = 256
const MAX_BITS: Int = 64

fn main()
    var pow2: [Int] = []
    var p = 1
    var i = 0
    while i < MAX_BITS do
        pow2.push(p)
        p = p * 2
        i = i + 1
    end
    var p_hash: [Int] = []
    var p_have: [Int] = []
    var p_peer_count: [Int] = []
    i = 0
    while i < N_PIECES do
        p_hash.push(i * 2654435761)
        p_have.push(0)
        p_peer_count.push(0)
        i = i + 1
    end
    var peer_next = 1
    var completed = 0
    i = 0
    while i < DEFAULT_WORKLOAD do
        let peer = peer_next
        peer_next = peer_next + 1
        let have_mask = i * 7
        var j = 0
        while j < N_PIECES do
            let bit = j % 64
            if (have_mask & pow2[bit as usize]) != 0 then
                p_peer_count[j as usize] = p_peer_count[j as usize] + 1
            end
            j = j + 1
        end
        j = 0
        while j < N_PIECES do
            if p_have[j as usize] == 0 then
                if p_peer_count[j as usize] > 0 then
                    p_have[j as usize] = 1
                    completed = completed + 1
                end
            end
            j = j + 1
        end
        i = i + 1
    end
    print("bittorrent: ops=", DEFAULT_WORKLOAD, "peers=", peer_next - 1, "pieces=", N_PIECES)
end
