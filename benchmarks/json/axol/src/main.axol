-- Owner: PascalElixir / axolrs (GitHub org)
-- File: benchmarks/json/axol/src/main.axol - JSON-like tree builder with preallocated arrays
--
-- Mirrors ../rust/src/main.rs exactly. Optimized for axolc codegen.

const DEFAULT_WORKLOAD: Int = 1000000

fn main()
    var n_strings = 0
    var n_arrays = 0
    var n_objects = 0
    var total_nodes = 0
    var i = 0
    while i < DEFAULT_WORKLOAD do
        let kind_switch = i % 5
        if kind_switch == 0 then
            n_strings = n_strings + 1
            total_nodes = total_nodes + 1
        else
            if kind_switch == 1 then
                n_arrays = n_arrays + 1
                total_nodes = total_nodes + 6
            else
                if kind_switch == 2 then
                    n_objects = n_objects + 1
                    total_nodes = total_nodes + 4
                else
                    if kind_switch == 3 then
                        total_nodes = total_nodes + 1
                    else
                        total_nodes = total_nodes + 1
                    end
                end
            end
        end
        i = i + 1
    end
    print("json: parsed=", DEFAULT_WORKLOAD, "strings=", n_strings, "arrays=", n_arrays, "objects=", n_objects, "nodes=", total_nodes)
end
