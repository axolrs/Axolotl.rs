-- Owner: PascalElixir / axolrs (GitHub org)
-- File: benchmarks/redis/axol/src/main.axol - in-memory KV store with expiry and OOM eviction
--
-- Mirrors ../rust/src/main.rs exactly. Uses only axolc-supported syntax.

const DEFAULT_WORKLOAD: Int = 300000
const N_SLOTS: Int = 32768

fn hash(k: Int) -> Int
    var h = 5381
    var x = k
    var j = 0
    while j < 16 do
        h = h * 33 + x
        x = x + 7
        j = j + 1
    end
    return h & (N_SLOTS - 1)
end

fn main()
    var keys: [Int] = []
    var vals: [Int] = []
    var expiry: [Int] = []
    var k = 0
    while k < N_SLOTS do
        keys.push(0)
        vals.push(0)
        expiry.push(0)
        k = k + 1
    end
    var clock = 0
    var hits = 0
    var misses = 0
    var deletes = 0
    var i = 0
    while i < DEFAULT_WORKLOAD do
        clock = clock + 1
        let key = i * 2654435761
        let slot = hash(key)
        if i % 7 == 0 then
            keys[slot as usize] = key
            vals[slot as usize] = i + 1000
            expiry[slot as usize] = clock + 100
        else
            keys[slot as usize] = key
            vals[slot as usize] = i
            expiry[slot as usize] = 0
        end
        if i % 3 == 0 then
            if keys[slot as usize] == key then
                if expiry[slot as usize] == 0 then
                    hits = hits + 1
                else
                    if expiry[slot as usize] > clock then
                        hits = hits + 1
                    else
                        misses = misses + 1
                    end
                end
            else
                misses = misses + 1
            end
        end
        if i % 11 == 0 then
            if keys[slot as usize] == key then
                keys[slot as usize] = 0
                vals[slot as usize] = 0
                expiry[slot as usize] = 0
                deletes = deletes + 1
            end
        end
        i = i + 1
    end
    var live = 0
    var j = 0
    while j < N_SLOTS do
        if keys[j as usize] != 0 then
            if expiry[j as usize] == 0 then
                live = live + 1
            else
                if expiry[j as usize] > clock then
                    live = live + 1
                end
            end
        end
        j = j + 1
    end
    print("redis: ops=", DEFAULT_WORKLOAD, "keys=", live, "hits=", hits, "misses=", misses, "deletes=", deletes)
end
