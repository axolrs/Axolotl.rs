-- Owner: PascalElixir / axolrs (GitHub org)
-- File: examples/primes.axol - array building with nested loops and a sieve.

fn main()
    var primes = []
    var n = 2
    while n <= 30 do
        var is_prime = true
        var d = 2
        while d * d <= n do
            if n % d == 0 then
                is_prime = false
                break
            end
            d = d + 1
        end
        if is_prime then
            primes.push(n)
        end
        n = n + 1
    end
    print("primes:", primes)
end
